# SQL dumps must never be downloadable. install.php is intentionally reachable
# for the one-time setup — delete this whole folder afterwards.
Options -Indexes

<FilesMatch "\.sql$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
